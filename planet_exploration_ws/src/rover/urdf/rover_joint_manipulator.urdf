<?xml version="1.0" ?><!-- Simple 4 wheeled tank drive Rover with Lidar Sensor and Camera Model -->
<robot name="rover">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size=".8 0.7 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba=".2 .2 .2 1" />
      </material>
    </visual>
    <inertial>
      <mass value="2" />
      <inertia ixx="0.04" ixy="0.0" ixz="0" iyy="0.17" iyz="0" izz="0.25" />
    </inertial>

    <collision>
      <geometry>
        <box size=".8 0.7 0.1"/>
      </geometry>
    </collision>
  </link>


  <link name="wheel_front_right">
    <inertial>
      <mass value="2" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>

      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>

      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <contact_coefficients mu="1" kp="1e+13" kd="1.0"/>
    </collision>
  </link>

  <joint name="wheel_front_right_joint" type="continuous">
    <origin xyz="0.25 0.4 0.0" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <link name="wheel_front_left">
    <inertial>
      <mass value="2" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>

      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <contact_coefficients mu="1" kp="1e+13" kd="1.0"/>
    </collision>
  </link>

  <joint name="wheel_front_left_joint" type="continuous">
    <origin xyz="0.25 -0.4 0.0" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="wheel_back_right">
    <inertial>
      <mass value="2" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>

      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <contact_coefficients mu="1" kp="1e+13" kd="1.0"/>
    </collision>
  </link>

  <joint name="wheel_back_right_joint" type="continuous">
    <origin xyz="-0.25 0.4 0.0" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_back_right"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="wheel_back_left">
    <inertial>
      <mass value="2" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>

    <visual>

      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <contact_coefficients mu="1" kp="1e+13" kd="1.0"/>
    </collision>
  </link>

  <joint name="wheel_back_left_joint" type="continuous">
    <origin xyz="-0.25 -0.4 0.0" rpy="1.57 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="wheel_back_left"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="camera">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>

    <visual>

      <geometry>
        <box size="0.1 0.5 0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.1 0.5 0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="-0.35 0 0.15" rpy="0 0.0 3.14"/>
    <parent link="base_link"/>
    <child link="camera"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>

  <link name="lidar">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.43 0 0.0" rpy="0 0.0 1.57"/>
    <parent link="base_link"/>
    <child link="lidar"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>


  <gazebo>
    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <left_joint>wheel_front_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <wheel_separation>0.8</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>]
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>base_footprint</odometry_frame>
      <robot_base_frame>chassis</robot_base_frame>

    </plugin>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>open_manipulator</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
    </plugin>
  </gazebo>

  <gazebo reference="camera">
    <sensor type="camera" name="camera1">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>/camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
    <material>Gazebo/Blue</material>
  </gazebo>


  <gazebo reference="lidar">
    <sensor name="gazebo_lidar" type="ray">
      <visualize>true</visualize>
      <update_rate>12.0</update_rate>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="gazebo_lidar">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.00</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_back_right">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="wheel_back_left">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="wheel_front_right">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="wheel_front_left">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="link1">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="link2">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="link3">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="link4">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="link5">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="gripper_left">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="gripper_right">
    <material>Gazebo/Gray</material>
  </gazebo>
  <!-- Robot Arm -->
  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link1.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="9.2628452e-04 0.0000000e+00 -3.6529383e-04" />
      <mass value="2.3735986e-01" />
      <inertia ixx="1.1251570e-04" ixy="0.0" ixz="-5.3565624e-07" iyy="1.5709509e-04" iyz="0.0" izz="1.7300208e-04" />
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>


  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.057" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link2.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.057" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link2.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-9.0554610e-04 1.6213105e-03 1.4230039e-01" />
      <mass value="2.9522041e-01" />
      <inertia ixx="1.0363027e-04" ixy="-4.8092985e-08" ixz="-1.1512546e-06" iyy="9.8067987e-05" iyz="8.5535816e-08" izz="5.6550961e-05" />
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.036 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1" lower="-1.57" upper="1.57" />
    <dynamics damping="0.1"/>
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link3.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link3.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="3.0925188e-02 1.1323009e-03 3.0510591e-01" />
      <mass value="4.1552751e-01" />
      <inertia ixx="9.9166143e-04" ixy="-2.9382294e-07" ixz="-1.1551713e-04" iyy="1.0287134e-03" iyz="-4.7132548e-06" izz="1.8103949e-04" />
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.0 0.1785" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="-0.94" upper="0.94" />
    <dynamics damping="0.1"/>
  </joint>

  <!-- Link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link4.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link4.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="2.7272877e-01 1.1678944e-03 6.7239837e-04" />
      <mass value="3.9823686e-01" />
      <inertia ixx="9.1962534e-05" ixy="-3.8292466e-06" ixz="-8.0623250e-07" iyy="7.2690876e-04" iyz="3.4678650e-08" izz="7.5465171e-04" />
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.072 0 0.384" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="-1.79" upper="2.04" />
    <dynamics damping="0.1"/>
  </joint>

  <!-- Link 5 -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link5.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/link5.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.3262026e-01 1.1051996e-06 2.6732665e-02" />
      <mass value="4.2982718e-01" />
      <inertia ixx="2.4261225e-04" ixy="0.0" ixz="-3.0473689e-06" iyy="2.2794140e-04" iyz="0.0" izz="2.7938212e-04" />
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.372 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="-1.79" upper="2.04" />
    <dynamics damping="0.1"/>
  </joint>

  <!-- Gripper Left -->
  <link name="gripper_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/gripper_left_palm.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/gripper_left_palm.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="3.0e-03" />
      <inertia ixx="3.0e-06" ixy="0.0" ixz="0.0" iyy="3.0e-06" iyz="0.0" izz="3.0e-06" />
    </inertial>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link5"/>
    <child link="gripper_left"/>
    <origin xyz="0.2451 0.0631 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1" lower="-0.03" upper="0.057" />
    <dynamics damping="0.1"/>
  </joint>

  <!-- Gripper Right -->
  <link name="gripper_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/gripper_right_palm.stl" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover/meshes/gripper_right_palm.stl" scale="0.003 0.003 0.003"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="3.0e-03" />
      <inertia ixx="3.0e-06" ixy="0.0" ixz="0.0" iyy="3.0e-06" iyz="0.0" izz="3.0e-06" />
    </inertial>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="link5"/>
    <child link="gripper_right"/>
    <origin xyz="0.2451 -0.0631 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit velocity="4.8" effort="1" lower="-0.03" upper="0.057" />
    <mimic joint="gripper_left_joint" multiplier="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red"/>
     </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="1e-03" />
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06" />
    </inertial>
  </link>
  
  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/>
    <child link="end_effector_link"/>
    <origin xyz="0.126 0.0 0.0" rpy="0 0 0"/>
  </joint>

</robot>
